  "role_dialogue": {
    "S4.go": [
      "请孔明启船",
      "鲁肃：“人船都齐了，走吗？”孔明：“走。韩伯解缆，各船跟紧。”"
    ],
    "S4.cancel": [
      "请孔明今夜停航",
      "鲁肃：“我还是担心，今夜先不走。”孔明：“好。船留岸，三日之约由我去交代。”"
    ],
    "S5.wait": [
      "请孔明再等一更",
      "鲁肃：“再等一更，看江面会不会变。”孔明：“便等这一更。韩伯，暂不解缆。”"
    ],
    "S5.go": [
      "请孔明清夜出发",
      "鲁肃：“雾没来，还要走吗？”孔明：“既定清夜去，就不能指望瞒住。退路先留好，解缆。”"
    ],
    "S5.cancel": [
      "请孔明取消行船",
      "鲁肃：“岸上看得太清楚，我不赞成今夜去。”孔明：“不去了。人下船，我去见都督。”"
    ],
    "S7.go": [
      "请孔明清夜启船",
      "鲁肃：“再等也不见雾，仍走这一趟？”孔明：“走。别靠得太近，见势不对便回。”"
    ],
    "S7.cancel": [
      "请孔明停航入帐",
      "鲁肃：“这一更已过，还是停下吧。”孔明：“好。把人送回营，我去交代。”"
    ],
    "S9.far": [
      "请孔明停在寨外",
      "鲁肃：“就在这里停吧，不必再近。”孔明：“停桨。韩伯守住来路。”"
    ],
    "S9.near": [
      "请孔明再近一些",
      "鲁肃：“再近些，兴许能看清寨门。”孔明：“近些，他们也会看清我们。依你所议，只近这一段。”"
    ],
    "S10.drum": [
      "请孔明发出击鼓令",
      "鲁肃：“人已藏好，现在叫他们听见？”孔明：“阿成，各船齐鼓！”"
    ],
    "S10.hail": [
      "请孔明先向寨中喊话",
      "鲁肃：“先喊一声，听他们怎么应。”孔明：“好。喊过便静下来听。”"
    ],
    "S10.listen": [
      "请孔明先听岸上",
      "鲁肃：“先别敲，听听岸上动静。”孔明：“鼓槌放下，别出声。”"
    ],
    "S11.go": [
      "请孔明现在归岸",
      "鲁肃：“还没有箭，再留也未必有用。回吧？”孔明：“收船。韩伯先点人。”"
    ],
    "S11.near": [
      "请孔明移近查明",
      "鲁肃：“移近些，看看他们到底在做什么。”孔明：“那边也会看见我们。韩伯，只近这一段。”"
    ],
    "S12.wait": [
      "请孔明等到更鼓",
      "鲁肃：“再等到下一声更鼓，如何？”孔明：“只到那一声。韩伯留好回路。”"
    ],
    "S12.near": [
      "请孔明移近观察",
      "鲁肃：“他们仍不射，近些看清再作打算。”孔明：“依你。若已被看穿，就不要再留。”"
    ],
    "S12.go": [
      "请孔明带人船回去",
      "鲁肃：“仍没有箭来，先把人带回去吧。”孔明：“收船。经过我向都督说明。”"
    ],
    "A0.turn": [
      "请孔明转向另一舷",
      "鲁肃：“右边已有箭，把另一面转过去？”孔明：“转。韩伯领头，后船依次跟上。”"
    ],
    "A0.go": [
      "请孔明现在收船",
      "鲁肃：“先带这些回去吧。”孔明：“好，不再留了。各船收回。”"
    ],
    "A0.other": [
      "问孔明还要怎样应对",
      "鲁肃：“就这样等下一阵，还是也还几箭？”孔明：“留着，是等；还箭，便是交手。子敬，你说呢？”"
    ],
    "A2.same": [
      "请孔明留原侧再等",
      "鲁肃：“先不还箭，就在这里再等一阵。”孔明：“再看这一阵。阿成，不必催鼓。”"
    ],
    "A2.fire": [
      "请孔明考虑回射",
      "鲁肃：“要不要还几箭，免得他们起疑？”孔明：“先把要用的箭取出来。用去的，就不能再交给都督。”"
    ],
    "A2.back": [
      "请孔明转舷",
      "鲁肃：“不还箭了，还是换另一面接。”孔明：“韩伯，转舷。”"
    ],
    "A3.turn": [
      "请孔明换向未受箭侧",
      "鲁肃：“这面不再添了，换另一面试试？”孔明：“转过去。后船看住长索。”"
    ],
    "A3.wait": [
      "请孔明再等到更鼓",
      "鲁肃：“等到更鼓响，若还不来便回。”孔明：“就等到那一声。”"
    ],
    "A3.go": [
      "请孔明带现有箭回去",
      "鲁肃：“没有新的一阵，带现有的回去吧。”孔明：“韩伯，收船。”"
    ],
    "A4.go": [
      "请孔明收船返航",
      "鲁肃：“两边都接上了，该回去了。”孔明：“正是。各船回南岸！”"
    ],
    "A4.wait": [
      "请孔明再留一阵",
      "鲁肃：“再多取一阵，如何？”孔明：“天色已近亮。既还要等，只到下一声更鼓。”"
    ],
    "A4.fire": [
      "请孔明考虑回射掩护",
      "鲁肃：“回去前还几箭，能不能遮掩？”孔明：“还了箭，便是交手。先看要用去多少。”"
    ],
    "H0.yes": [
      "请孔明确认回射",
      "鲁肃：“这八千支，还是发出去。”孔明：“准。弓手还箭，韩伯随后撤船。”"
    ],
    "H0.no": [
      "请孔明不回射，直接返航",
      "鲁肃：“留着交箭，不还了，回吧。”孔明：“弓手收手，各船返航。”"
    ],
    "S15.hear": [
      "请孔明停鼓听清",
      "鲁肃：“忽然停了，听他们在喊什么。”孔明：“停鼓。都别出声。”"
    ],
    "S15.bluff": [
      "请孔明击一通鼓",
      "鲁肃：“击一通鼓，看他们会不会接着射。”孔明：“阿成，只这一通，随后静听。”"
    ],
    "S15.go": [
      "请孔明趁此退回",
      "鲁肃：“他们起疑了，趁退路还在，走吧。”孔明：“收船，不再添声势。”"
    ],
    "S16.go": [
      "请孔明立即撤回",
      "鲁肃：“他们看穿了，不能再等！”孔明：“韩伯，回南岸！”"
    ],
    "S16.wait": [
      "请孔明再等一阵",
      "鲁肃：“也许他们还会开弓，再等一下？”孔明：“只等到更鼓，后船不要散。”"
    ],
    "S17.go": [
      "喊韩伯收船",
      "鲁肃：“韩伯，快收船！”孔明：“撤回南岸，各船跟紧！”"
    ],
    "F2.continue": [
      "请孔明再看一阵",
      "鲁肃：“火落水了，他们换了普通箭，还留吗？”孔明：“再看这一阵，随时备着收船。”"
    ],
    "F2.leave": [
      "请孔明立即退回",
      "鲁肃：“火箭已经到了船边，不等了！”孔明：“收船，先离开这里。”"
    ],
    "F3.leave": [
      "请孔明现在撤回",
      "鲁肃：“火灭了，人也齐，回去吧。”孔明：“带好人，退！”"
    ],
    "F3.continue": [
      "请孔明只再留一阵",
      "鲁肃：“看他们又换普通箭了，只留这一阵？”孔明：“先看能用的船侧。只这一阵，接不住也要退。”"
    ]
  },
