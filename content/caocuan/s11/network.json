{
  "version": "S1.1",
  "scope": "authoring walk only, not product",
  "presets": [
    "standard",
    "late_fog",
    "clear",
    "quiet",
    "fire_contact",
    "fire_miss",
    "fire_after_turn",
    "counterfire",
    "no_contact"
  ],
  "nodes": {
    "S0": {
      "id": "S0",
      "scene": "M02",
      "title": "借船",
      "speaker": "诸葛亮",
      "speech": "二十只轻船，青布作幔，草束立在两旁。",
      "prompt": "随韩伯去看船",
      "kind": "choice",
      "edges": [
        {
          "id": "S0.look",
          "label": "去看船",
          "to": "S1",
          "reply": "韩伯拉住缆绳，领你到船舷边。",
          "when": "True",
          "effects": {}
        }
      ]
    },
    "S1": {
      "id": "S1",
      "scene": "M03",
      "title": "船舷上的兵",
      "speaker": "韩伯",
      "speech": "草束系牢便能立住；空甲有兵形，里面却没人。",
      "prompt": "挑一种布置，放到船舷",
      "kind": "choice",
      "edges": [
        {
          "id": "S1.straw",
          "label": "用草束",
          "to": "S2",
          "reply": "草束立上外侧，韩伯拿绳来系。",
          "when": "True",
          "effects": {
            "material": "straw"
          }
        },
        {
          "id": "S1.armor",
          "label": "用木撑空甲",
          "to": "S2",
          "reply": "鲁肃：远看像兵。近了，怕就瞒不住。",
          "when": "True",
          "effects": {
            "material": "armor"
          }
        }
      ]
    },
    "S2": {
      "id": "S2",
      "scene": "M03",
      "title": "另一侧也要摆吗",
      "speaker": "韩伯",
      "speech": "中间给人留路。另一边也照着摆，还是先空着？",
      "prompt": "完成两侧布置，或明确留空一侧",
      "kind": "choice",
      "edges": [
        {
          "id": "S2.both",
          "label": "两侧都摆好",
          "to": "S3",
          "reply": "船工沿两侧验绳，舱道能走人。",
          "when": "True",
          "effects": {
            "layout": "both"
          }
        },
        {
          "id": "S2.one",
          "label": "只摆右舷，左舷留空",
          "to": "S3",
          "reply": "韩伯：先生吩咐两侧。你留一边空着，那边的人可不能站出去。学生确认，左舷留空。",
          "when": "True",
          "effects": {
            "layout": "one"
          }
        }
      ]
    },
    "S3": {
      "id": "S3",
      "scene": "M04",
      "title": "岸边实际天气",
      "speaker": "镜头",
      "speech": "此项为制作条件，不给学生选择。",
      "prompt": "",
      "kind": "director",
      "edges": [
        {
          "id": "S3.fog",
          "label": "江上已起雾",
          "to": "S4",
          "reply": "近船仍可见，远岸的灯消失。",
          "when": "weather=='fog'",
          "effects": {}
        },
        {
          "id": "S3.clear",
          "label": "远岸仍清楚",
          "to": "S5",
          "reply": "韩伯：对岸的灯，一盏一盏都数得清。",
          "when": "weather=='clear'",
          "effects": {}
        }
      ]
    },
    "S4": {
      "id": "S4",
      "scene": "M04",
      "title": "雾已起",
      "speaker": "诸葛亮",
      "speech": "各船跟紧，不要走散。",
      "prompt": "决定启船或取消",
      "kind": "choice",
      "edges": [
        {
          "id": "S4.go",
          "label": "按计划启船",
          "to": "S8",
          "reply": "韩伯解缆，桨落入水，船逐一离岸。",
          "when": "True",
          "effects": {
            "launched": true
          }
        },
        {
          "id": "S4.cancel",
          "label": "今晚不出发",
          "to": "X7",
          "reply": "孔明：既不出船，天明我去见都督。人船留岸。",
          "when": "True",
          "effects": {
            "ending": "E7"
          }
        }
      ]
    },
    "S5": {
      "id": "S5",
      "scene": "M04",
      "title": "没有雾",
      "speaker": "鲁肃",
      "speech": "没有雾遮着，他们岂不一眼看见我们？",
      "prompt": "等一更、清夜启船，或取消",
      "kind": "choice",
      "edges": [
        {
          "id": "S5.wait",
          "label": "等到下一更",
          "to": "S6",
          "reply": "更鼓响过，灯芯短了一截。再看江面。",
          "when": "True",
          "effects": {}
        },
        {
          "id": "S5.go",
          "label": "清夜仍然启船",
          "to": "S8",
          "reply": "孔明：没有雾，见势不对，立即收船。韩伯复述退路后解缆。",
          "when": "True",
          "effects": {
            "launched": true
          }
        },
        {
          "id": "S5.cancel",
          "label": "取消今夜行船",
          "to": "X7",
          "reply": "船工放下桨，泊岸绳未解。",
          "when": "True",
          "effects": {
            "ending": "E7"
          }
        }
      ]
    },
    "S6": {
      "id": "S6",
      "scene": "M04",
      "title": "等待后的天气",
      "speaker": "镜头",
      "speech": "此项为制作条件，不给学生选择。",
      "prompt": "",
      "kind": "director",
      "edges": [
        {
          "id": "S6.arrive",
          "label": "迟雾改编中雾来到",
          "to": "S4",
          "reply": "远处岸灯渐渐隐去。",
          "when": "preset=='late_fog'",
          "effects": {
            "weather": "fog"
          }
        },
        {
          "id": "S6.same",
          "label": "晴夜改编中仍无雾",
          "to": "S7",
          "reply": "韩伯：更鼓过去了，寨门仍看得清。",
          "when": "preset!='late_fog'",
          "effects": {}
        }
      ]
    },
    "S7": {
      "id": "S7",
      "scene": "M04",
      "title": "最后的岸边决定",
      "speaker": "诸葛亮",
      "speech": "再留便误了时辰。去，还是不去？",
      "prompt": "明确启船或取消，不无限等天气",
      "kind": "choice",
      "edges": [
        {
          "id": "S7.go",
          "label": "清夜启船",
          "to": "S8",
          "reply": "各船从清楚可见的岸影前经过。",
          "when": "True",
          "effects": {
            "launched": true
          }
        },
        {
          "id": "S7.cancel",
          "label": "不出船，入帐说明",
          "to": "X7",
          "reply": "韩伯把桨收回，先送人下船。",
          "when": "True",
          "effects": {
            "ending": "E7"
          }
        }
      ]
    },
    "S8": {
      "id": "S8",
      "scene": "M05",
      "title": "寨外发问K1",
      "speaker": "鲁肃",
      "speech": "孔明，你说来取箭，怎倒把船开到曹营来了？",
      "prompt": "向孔明问清担忧；诸葛亮入口回应鲁肃",
      "kind": "choice",
      "edges": [
        {
          "id": "S8.ask",
          "label": "向孔明说清这一处担忧",
          "to": "S9",
          "reply": "鲁肃原问存入K1；孔明说明借箭打算，韩伯听令留好退路。",
          "when": "True",
          "effects": {
            "utterance": true,
            "utterance_kind": "@utterance_kind"
          },
          "label_by_role": {
            "Z": "回应鲁肃，并安排退路"
          },
          "reply_by_role": {
            "Z": "保存诸葛亮的本次回应；鲁肃旧问仍为独立原件，韩伯按已确认安排留好退路。"
          }
        },
        {
          "id": "S8.route",
          "label": "先请韩伯指明退路",
          "to": "S9",
          "reply": "韩伯指向来路。孔明：不登岸，各船听我号令。",
          "when": "True",
          "effects": {}
        }
      ]
    },
    "S9": {
      "id": "S9",
      "scene": "M05",
      "title": "停在哪里",
      "speaker": "韩伯",
      "speech": "前头就是曹营。还往近处走吗？",
      "prompt": "在江面选定停船位置",
      "kind": "choice",
      "edges": [
        {
          "id": "S9.far",
          "label": "留在原处",
          "to": "S10",
          "reply": "韩伯收住桨，船停在寨外。",
          "when": "True",
          "effects": {
            "distance": "far"
          }
        },
        {
          "id": "S9.near",
          "label": "靠近看清",
          "to": "S10",
          "reply": "岸上轮廓清楚些，岸上也更容易看见来船。",
          "when": "True",
          "effects": {
            "distance": "near"
          }
        }
      ]
    },
    "S10": {
      "id": "S10",
      "scene": "M06",
      "title": "让曹营听见",
      "speaker": "阿成",
      "speech": "船已摆好。现在敲鼓？",
      "prompt": "在鼓、人声与静听中决定",
      "kind": "choice",
      "edges": [
        {
          "id": "S10.drum",
          "label": "传令各船齐鼓",
          "to": "D0",
          "reply": "一通鼓从本船传到全队，人声跟上。",
          "when": "True",
          "effects": {
            "method": "drum"
          }
        },
        {
          "id": "S10.hail",
          "label": "先向寨中喊话",
          "to": "D0",
          "reply": "喊声传向寨门，船上停下来听。",
          "when": "True",
          "effects": {
            "method": "hail"
          }
        },
        {
          "id": "S10.listen",
          "label": "先听岸上动静",
          "to": "D0",
          "reply": "鼓槌放下，岸灯移动。",
          "when": "True",
          "effects": {
            "method": "listen"
          }
        }
      ]
    },
    "D0": {
      "id": "D0",
      "scene": "M06",
      "title": "对岸第一次回应",
      "speaker": "镜头",
      "speech": "此项为制作条件，不给学生选择。",
      "prompt": "",
      "kind": "director",
      "edges": [
        {
          "id": "D0.seen",
          "label": "清夜或近处空甲被看清",
          "to": "S16",
          "reply": "岸上传来：都别放箭，先看清那船！",
          "when": "weather=='clear' or (material=='armor' and distance=='near')",
          "effects": {
            "revealed": true
          }
        },
        {
          "id": "D0.fire",
          "label": "雾中火箭改编且已发声",
          "to": "F0",
          "reply": "先见岸上火光，再见燃着的箭划来。",
          "when": "weather=='fog' and not(material=='armor' and distance=='near') and preset in ['fire_contact','fire_miss'] and method!='listen'",
          "effects": {}
        },
        {
          "id": "D0.quiet",
          "label": "仍未开弓",
          "to": "S11",
          "reply": "岸灯有人走动，却没有箭来。",
          "when": "weather=='fog' and not(material=='armor' and distance=='near') and (preset=='quiet' or method=='listen')",
          "effects": {}
        },
        {
          "id": "D0.volley",
          "label": "浓雾中普通齐射",
          "to": "A0",
          "reply": "岸上弓弦响过，一阵箭落在当前船舷。",
          "when": "weather=='fog' and not(material=='armor' and distance=='near') and preset not in ['fire_contact','fire_miss','quiet'] and method!='listen'",
          "effects": {
            "first": "@first_batch"
          }
        }
      ]
    },
    "S11": {
      "id": "S11",
      "scene": "M09",
      "title": "从未开弓",
      "speaker": "阿成",
      "speech": "岸上还是没动静。换个办法，还是回去？",
      "prompt": "最多换一次未用过的办法",
      "kind": "choice",
      "edges": [
        {
          "id": "S11.change",
          "label": "做一次尚未用过的喊话或击鼓",
          "to": "D1",
          "reply": "按实际已用办法选另一种：敲过鼓便喊话；已喊话或仅静听便敲鼓。",
          "when": "True",
          "effects": {
            "changed": true,
            "method": "@alternate_method"
          }
        },
        {
          "id": "S11.go",
          "label": "现在归岸",
          "to": "R0",
          "reply": "韩伯收索转向，空草束跟船一同回去。",
          "when": "True",
          "effects": {}
        },
        {
          "id": "S11.near",
          "label": "移近看看",
          "to": "S16",
          "reply": "哨艇看清了装置，岸上喊停；并非系统无故识破。",
          "when": "True",
          "effects": {
            "distance": "near",
            "revealed": true
          }
        }
      ]
    },
    "D1": {
      "id": "D1",
      "scene": "M09",
      "title": "换法后的回应",
      "speaker": "镜头",
      "speech": "此项为制作条件，不给学生选择。",
      "prompt": "",
      "kind": "director",
      "edges": [
        {
          "id": "D1.still",
          "label": "静寨仍不开弓",
          "to": "S12",
          "reply": "阿成：岸上还是不射。只报告实际做过的事，不补造喊话或击鼓。",
          "when": "preset=='quiet'",
          "effects": {}
        },
        {
          "id": "D1.fire",
          "label": "火箭改编此时首次发声",
          "to": "F0",
          "reply": "岸上亮起火箭，船上先看见来向。",
          "when": "preset in ['fire_contact','fire_miss']",
          "effects": {}
        },
        {
          "id": "D1.arrows",
          "label": "普通改编此时引来第一阵",
          "to": "A0",
          "reply": "弓弦声起，第一侧实际受箭。",
          "when": "preset not in ['quiet','fire_contact','fire_miss']",
          "effects": {
            "first": "@first_batch"
          }
        }
      ]
    },
    "S12": {
      "id": "S12",
      "scene": "M09",
      "title": "试过仍没有回应",
      "speaker": "鲁肃",
      "speech": "他们不肯开弓，还留在这里吗？",
      "prompt": "等待有明确时刻，或马上退",
      "kind": "choice",
      "edges": [
        {
          "id": "S12.wait",
          "label": "等到下一声更鼓",
          "to": "S17",
          "reply": "更鼓响，雾开始薄，岸楼露出轮廓。",
          "when": "True",
          "effects": {
            "late": true,
            "weather": "@later_visibility"
          }
        },
        {
          "id": "S12.near",
          "label": "移近查明",
          "to": "S16",
          "reply": "来船与哨艇互相看清，对岸喊出装置。",
          "when": "True",
          "effects": {
            "distance": "near",
            "revealed": true
          }
        },
        {
          "id": "S12.go",
          "label": "带人船回去",
          "to": "R0",
          "reply": "没有箭可取，韩伯先点人再返航。",
          "when": "True",
          "effects": {}
        }
      ]
    },
    "A0": {
      "id": "A0",
      "scene": "M07",
      "title": "第一侧受箭",
      "speaker": "韩伯",
      "speech": "右边已经密了，左边还空着。",
      "prompt": "看看两侧，再决定转舷或收船",
      "kind": "choice",
      "edges": [
        {
          "id": "A0.turn",
          "label": "把另一侧转过去",
          "to": "A1",
          "reply": "手握船舵，预览目标，确认传令后全队依次转向。",
          "when": "True",
          "effects": {
            "turned": true
          }
        },
        {
          "id": "A0.go",
          "label": "现在收船",
          "to": "R0",
          "reply": "孔明看过船侧：不再留了，收船。",
          "when": "True",
          "effects": {}
        },
        {
          "id": "A0.other",
          "label": "商议再等或回射",
          "to": "A2",
          "reply": "鼓手暂不敲，给这两个具体打算留出一次商议。",
          "when": "True",
          "effects": {}
        }
      ]
    },
    "A1": {
      "id": "A1",
      "scene": "M08",
      "title": "另一侧接续",
      "speaker": "镜头",
      "speech": "此项为制作条件，不给学生选择。",
      "prompt": "",
      "kind": "director",
      "edges": [
        {
          "id": "A1.fire",
          "label": "转舷后火箭改编",
          "to": "F0",
          "reply": "转到一半，韩伯看见岸上亮起火箭；同一条船仍只有已取得的第一批箭。",
          "when": "preset=='fire_after_turn'",
          "effects": {}
        },
        {
          "id": "A1.empty",
          "label": "另一侧原来没布置",
          "to": "A3",
          "reply": "韩伯：这边没有草束，箭落过去也留不住。",
          "when": "preset!='fire_after_turn' and layout=='one'",
          "effects": {}
        },
        {
          "id": "A1.suspect",
          "label": "空甲异常被注意",
          "to": "S15",
          "reply": "岸上传来：那排盔甲，怎么一动不动？箭声停了。",
          "when": "preset!='fire_after_turn' and layout=='both' and material=='armor'",
          "effects": {}
        },
        {
          "id": "A1.second",
          "label": "草束另一侧接到新一阵",
          "to": "A4",
          "reply": "阿成换号令，另一侧真的接上一批箭。",
          "when": "preset!='fire_after_turn' and layout=='both' and material=='straw'",
          "effects": {
            "second": 51000
          }
        }
      ]
    },
    "A2": {
      "id": "A2",
      "scene": "M11",
      "title": "原侧再等或还箭",
      "speaker": "鲁肃",
      "speech": "再等他们射，还是还几箭，免得露馅？",
      "prompt": "这两件事后果不同",
      "kind": "choice",
      "edges": [
        {
          "id": "A2.same",
          "label": "留原侧再等",
          "to": "A3",
          "reply": "箭声渐稀，这一侧不再增加新的整批箭。",
          "when": "True",
          "effects": {}
        },
        {
          "id": "A2.fire",
          "label": "回射一阵",
          "to": "H0",
          "reply": "沈砚指出将用去的八千支箭。先确认再拿走。",
          "when": "True",
          "effects": {}
        },
        {
          "id": "A2.back",
          "label": "还是转舷",
          "to": "A1",
          "reply": "韩伯接回调头命令，各船按次序转。",
          "when": "True",
          "effects": {
            "turned": true
          }
        }
      ]
    },
    "A3": {
      "id": "A3",
      "scene": "M07",
      "title": "没有新的一批箭",
      "speaker": "韩伯",
      "speech": "箭声稀了，没有新的一阵。船要怎么走？",
      "prompt": "只允许一次有后果的再等待",
      "kind": "choice",
      "edges": [
        {
          "id": "A3.turn",
          "label": "把有布置且未用的一侧转过去",
          "to": "A1",
          "reply": "这次真正调船，不把镜头旋转当转舷。",
          "when": "layout=='both' and not turned",
          "effects": {
            "turned": true
          }
        },
        {
          "id": "A3.wait",
          "label": "等到更鼓响",
          "to": "S17",
          "reply": "雾散开一层，岸影变清楚。",
          "when": "True",
          "effects": {
            "late": true,
            "weather": "@later_visibility"
